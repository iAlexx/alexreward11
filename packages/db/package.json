{
  "name": "@alex-rewards/db",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:phase2": "cross-env PHASE2_MIGRATION_TESTS=1 vitest run test/phase2-migrations.test.ts"
  },
  "dependencies": {
    "kysely": "0.29.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
