{
  "name": "@alex-rewards/ads",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --fileParallelism=false --passWithNoTests",
    "test:phase11": "cross-env PHASE11_ADS_TESTS=1 vitest run --fileParallelism=false test/phase11-boundaries.test.ts test/phase11-certification.test.ts test/phase11-limits-version.test.ts test/phase11-p11-01-request-counting.test.ts"
  },
  "dependencies": {
    "@alex-rewards/db": "workspace:*",
    "@alex-rewards/rewards": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
