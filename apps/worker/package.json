{
  "name": "@alex-rewards/worker",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "start:tailscale": "sh ./scripts/start-tailscale.sh",
    "test:phase21-e2e": "cross-env PHASE7_WITHDRAWAL_TESTS=1 ALEX_OWNER_BOOTSTRAP_TEST_HOOKS=1 ALEX_OWNER_BOOTSTRAP_DISPOSABLE_PRODUCTION_SIM=1 ALEX_PHASE21_CEREMONY_TEST_HOOKS=1 vitest run --fileParallelism=false test/phase21-mainnet-e2e-financial.test.ts test/phase21-gen2-recovery-e2e.test.ts test/phase21-gen2-temporal-launch.test.ts test/phase21-gen3-recovery-e2e.test.ts test/phase21-gen3-temporal-launch.test.ts test/phase21-gen4-recovery-e2e.test.ts test/phase21-gen4-temporal-launch.test.ts",
    "phase21:gen2-temporal-launch": "node dist/cli/phase21-gen2-temporal-launch.js",
    "phase21:gen3-temporal-launch": "node dist/cli/phase21-gen3-temporal-launch.js",
    "phase21:gen4-temporal-launch": "node dist/cli/phase21-gen4-temporal-launch.js"
  },
  "dependencies": {
    "@alex-rewards/config": "workspace:*",
    "@alex-rewards/contracts": "workspace:*",
    "@alex-rewards/db": "workspace:*",
    "@alex-rewards/observability": "workspace:*",
    "@alex-rewards/referrals": "workspace:*",
    "@alex-rewards/rewards": "workspace:*",
    "@alex-rewards/signing": "workspace:*",
    "@alex-rewards/tasks": "workspace:*",
    "@alex-rewards/withdrawals": "workspace:*",
    "@temporalio/activity": "1.23.0",
    "@temporalio/client": "1.23.0",
    "@temporalio/worker": "1.23.0",
    "@temporalio/workflow": "1.23.0",
    "fastify": "5.12.2",
    "pg": "8.23.0",
    "@alex-rewards/ton": "workspace:*"
  },
  "devDependencies": {
    "@temporalio/testing": "1.23.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "cross-env": "7.0.3",
    "vitest": "4.1.11"
  }
}
