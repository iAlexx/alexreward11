{
  "name": "@alex-rewards/api",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:phase12": "cross-env PHASE12_API_TESTS=1 vitest run --fileParallelism=false test/phase12-read-models.test.ts test/phase12-read-apis-db.test.ts test/phase12-settings-privacy.test.ts"
  },
  "dependencies": {
    "@alex-rewards/ads": "workspace:*",
    "@alex-rewards/auth": "workspace:*",
    "@alex-rewards/config": "workspace:*",
    "@alex-rewards/contracts": "workspace:*",
    "@alex-rewards/db": "workspace:*",
    "@alex-rewards/ledger": "workspace:*",
    "@alex-rewards/observability": "workspace:*",
    "@alex-rewards/rewards": "workspace:*",
    "@alex-rewards/support": "workspace:*",
    "@alex-rewards/telegram": "workspace:*",
    "@alex-rewards/ton": "workspace:*",
    "@alex-rewards/wallets": "workspace:*",
    "@alex-rewards/withdrawals": "workspace:*",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@temporalio/client": "1.23.0",
    "fastify": "5.12.1",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "cross-env": "10.1.0",
    "pg": "8.23.0",
    "tsx": "4.23.13"
  }
}
