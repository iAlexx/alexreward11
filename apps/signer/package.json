{
  "name": "@alex-rewards/signer",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "keygen": "tsx src/cli/generate-hot-wallet-key.ts",
    "local-unlock": "tsx src/cli/local-unlock.ts"
  },
  "dependencies": {
    "@alex-rewards/config": "workspace:*",
    "@alex-rewards/contracts": "workspace:*",
    "@alex-rewards/db": "workspace:*",
    "@alex-rewards/observability": "workspace:*",
    "@alex-rewards/signing": "workspace:*",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}
