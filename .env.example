# Local development only. Never reuse these values in staging or production.
DEPLOYMENT_ENV=local
NODE_ENV=development
LOG_LEVEL=info
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

POSTGRES_USER=alex_rewards
POSTGRES_PASSWORD=local-alex-rewards-only
POSTGRES_DB=alex_rewards
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://alex_rewards:local-alex-rewards-only@localhost:5432/alex_rewards
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=alex-rewards-foundation

API_PORT=3002
BOT_PORT=3003
WORKER_PORT=3004
SIGNER_PORT=3005
BOT_TRANSPORT_MODE=disabled
# Local/test Mini App HMAC + bot token. Never reuse in staging/production.
TELEGRAM_BOT_TOKEN=local-only-telegram-bot-token-for-dev
# Local/test access-token HMAC secret (min 32 chars). Production must use managed secret.
SESSION_ACCESS_SECRET=local-only-session-access-secret-32b
# Local/test session TTLs only. Production cookie topology/TTLs remain environment-specific.
SESSION_ACCESS_TTL_SECONDS=900
SESSION_REFRESH_TTL_SECONDS=2592000
INITDATA_MAX_AGE_SECONDS=86400
# Comma-separated browser origins for CORS. Empty disables cross-origin browser calls.
CORS_ORIGINS=http://localhost:3000
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=30
CLAIM_RATE_LIMIT_WINDOW_SECONDS=300
CLAIM_RATE_LIMIT_MAX=10

# Local/test withdrawal engine defaults only. Staging/production must set reviewed values.
WITHDRAWAL_QUOTE_TTL_SECONDS=300
WITHDRAWAL_RISK_POLICY_VERSION=1
WITHDRAWAL_NETWORK_CODE=TON_TESTNET
WITHDRAWAL_ASSET_SYMBOL=USDT
WITHDRAWAL_FAKE_CHAIN_ENABLED=true

# Phase 10 Testnet payout foundation (LOCAL defaults OFF for real chain).
# FORBIDDEN: MAINNET network codes / networkGlobalId -239.
# Owner must supply TON_TESTNET_JETTON_MASTER before enabling real chain.
WITHDRAWAL_REAL_CHAIN_ENABLED=false
SIGNER_BASE_URL=http://127.0.0.1:3005
# Owner-approved Testnet Jetton master only — leave empty until Owner provides it.
TON_TESTNET_JETTON_MASTER=
# Testnet HTTP JSON-RPC provider base URLs (no secrets in repo).
TON_PRIMARY_PROVIDER_URL=
TON_SECONDARY_PROVIDER_URL=
# Optional provider API key — never commit a real key.
TON_PROVIDER_API_KEY=

# Generate a unique 32+ character local value. Production must use a managed secret.
SIGNER_SERVICE_TOKEN=replace-with-a-random-32-character-local-token
# Phase 9 signer (local defaults). Staging/production must use self_hosted_encrypted.
SIGNER_DATABASE_URL=postgresql://alex_rewards:local-alex-rewards-only@localhost:55432/alex_rewards
SIGNER_KEY_MODE=local_ephemeral
# SIGNER_KEY_MODE=self_hosted_encrypted
# SIGNER_KEY_BUNDLE_PATH=/run/alex-rewards/signer/hot-wallet.enc
# SIGNER_EXPECTED_SIGNER_REFERENCE=
# FORBIDDEN (never set in env / .env / secrets managers as plaintext process env):
# SIGNER_PRIVATE_KEY / SIGNER_SEED / SIGNER_MNEMONIC / SIGNER_KEY_PASSPHRASE
# Passphrase is supplied only via interactive local unlock (loopback), never via env.
SIGNER_SPIKE_ENABLED=true
SIGNER_NETWORK_CODE=TON_TESTNET
SIGNER_NETWORK_GLOBAL_ID=-3
SIGNER_WALLET_VERSION=v5R1
SIGNER_WORKCHAIN=0
SIGNER_EXPECTED_ASSET_SYMBOL=USDT

NEXT_PUBLIC_API_BASE_URL=http://localhost:3002
NEXT_PUBLIC_SENTRY_DSN=
